{
  "manifest_version": 3,
  "name": "Image Harvester",
  "version": "1.0.0",
  "description": "Collect every image on a page, filter them, remove near-duplicates by perceptual hash, and download the best copies.",
  "minimum_chrome_version": "116",
  "permissions": [
    "webRequest",
    "scripting",
    "downloads",
    "sidePanel",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Image Harvester",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
